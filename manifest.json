{
  "manifest_version": 3,
  "name": "Viewly",
  "version": "0.1.0",
  "description": "Preview any page on multiple devices at once. Local-first, no account, no tracking.",
  "action": { "default_popup": "popup.html", "default_title": "Viewly" },
  "background": { "service_worker": "background.js" },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_start"
  }]
}
